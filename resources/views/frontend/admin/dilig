                    </div>
                    <!-- Formalités (Complexes vs Simples) -->
                    <div class="col-md-6">
                        <div class="chart-container">
                            <div class="chart-header">
                                <h4>Formalités (Complexes vs Simples)</h4>
                            </div>
                            <canvas id="formalitesChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- 2ème ligne : Tranche d'âge vs Sexe -->
                <div class="row">
                    <!-- Tranche d'âge -->
                    <div class="col-md-6">

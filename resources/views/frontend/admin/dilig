<!-- SCRIPTS -->
<script src="../assets/js/core/jquery-3.7.1.min.js"></script>
<script src="../assets/js/core/popper.min.js"></script>
<script src="../assets/js/core/bootstrap.min.js"></script>
<script src="../assets/js/plugin/chart.js/chart.min.js"></script>
<script src="../assets/js/plugin/datatables/datatables.min.js"></script>
<script src="../assets/js/kaiadmin.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function() {
    // On récupère la distribution Complexité
    // ex. ["Procédures Longues","Procédures Courtes","Formalités Complexes","Formalités Simples"]
    const complexityLabels = @json($complexityLabels);
    const complexityData = @json($complexityData);

    // 1) ProcéduresChart => indices 0,1
    new Chart(document.getElementById('proceduresChart'), {
        type: 'pie',
        data: {
            labels: [complexityLabels[0], complexityLabels[1]],
            datasets: [{
                data: [complexityData[0], complexityData[1]],
                backgroundColor: ['#3498db','#e74c3c']
            }]
        },
        options: { responsive: true }
    });

    // 2) FormalitesChart => indices 2,3
    new Chart(document.getElementById('formalitesChart'), {
        type: 'pie',
        data: {
            labels: [complexityLabels[2], complexityLabels[3]],
            datasets: [{
                data: [complexityData[2], complexityData[3]],
                backgroundColor: ['#2ecc71','#f1c40f']
            }]
        },
        options: { responsive: true }
    });

    // Répartition par Âge
    new Chart(document.getElementById('ageChart'), {
        type: 'bar',
        data: {
            labels: @json($ageLabels),
            datasets: [{
                label: "Tranche d'âge",
                data: @json($ageData),
                backgroundColor: "#4e73df"
            }]
        },
        options: {
            responsive: true,
            scales: { y: { beginAtZero: true } }
        }
    });

    // Répartition par Sexe
    new Chart(document.getElementById('genderChart'), {
        type: 'pie',
        data: {
            labels: @json($genderLabels),
            datasets: [{
                data: @json($genderData),
                backgroundColor: ['#8e44ad','#e74c3c']
            }]
        },
        options: { responsive: true }
    });

    // Répartition par Localité
    new Chart(document.getElementById('localityChart'), {
        type: 'doughnut',
        data: {
            labels: @json($localityLabels),
            datasets: [{
                data: @json($localityData),
                backgroundColor: ['#27ae60','#d35400']
            }]
        },
        options: { responsive: true }
    });

    // DataTables sur le tableau
    $('#diligenceTable').DataTable({
        searching: false, // On peut le désactiver si on veut
        ordering: false,
        info: false,
        lengthChange: false,
        pageLength: 1
    });
});
</script>

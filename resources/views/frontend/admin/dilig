                <!-- TABLEAU RÉCAPITULATIF -->
                <div class="table-container">
                    <h4>Tableau Récapitulatif</h4>
                    <table id="diligenceTable" class="table table-bordered table-striped text-center">
                        <thead class="table-dark">
                            <tr>
                                <th>Tranche d'âge majoritaire</th>
                                <th>Sexe majoritaire</th>
                                <th>Localité majoritaire</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <!-- On récupère le label d'âge majoritaire -->
                                <td>
                                    {{ count($ageData) ? $ageLabels[array_search(max($ageData), $ageData)] : 'N/A' }}
                                </td>
                                <!-- On récupère le sexe majoritaire -->
                                <td>
                                    {{ count($genderData) ? $genderLabels[array_search(max($genderData), $genderData)] : 'N/A' }}
                                </td>
                                <!-- On récupère la localité majoritaire -->
                                <td>
                                    {{ count($localityData) ? $localityLabels[array_search(max($localityData), $localityData)] : 'N/A' }}
                                </td>
                            </tr>

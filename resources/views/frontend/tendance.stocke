          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="satisfaction_participation" value="moyennement_satisfait" id="part3">
            <label class="form-check-label" for="part3">Moyennement satisfait</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="satisfaction_participation" value="insatisfait" id="part4">
            <label class="form-check-label" for="part4">Insatisfait</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="satisfaction_participation" value="tres_insatisfait" id="part5">
            <label class="form-check-label" for="part5">Très insatisfait</label>
          </div>
        </div>

        <div class="question">
          <label class="form-label">
            Pensez-vous que l’utilisation de plateformes numériques pourrait faciliter la participation citoyenne ?
          </label>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="facilite_numerique" value="oui" id="facil_oui">
            <label class="form-check-label" for="facil_oui">Oui</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="facilite_numerique" value="non" id="facil_non">
            <label class="form-check-label" for="facil_non">Non</label>
          </div>
        </div>

        <div class="question">
          <label class="form-label">
            Quels aspects de l’inclusion citoyenne pourraient être améliorés ?
            <span class="text-muted">(optionnel)</span>
          </label>
          <textarea class="form-control" name="aspects_inclusion" rows="3"></textarea>
        </div>

        <div class="question">
          <label class="form-label">
            Pensez-vous que la participation citoyenne a un impact réel sur les décisions concernant les réformes des services publics ?
          </label>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="impact_reel" value="oui" id="impactreel_oui">
            <label class="form-check-label" for="impactreel_oui">Oui</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="impact_reel" value="non" id="impactreel_non">
            <label class="form-check-label" for="impactreel_non">Non</label>
          </div>
        </div>

        <div class="question">
          <label class="form-label">
            Quelles suggestions auriez-vous pour améliorer l’inclusion et la participation des citoyens dans les réformes des services publics ?
          </label>
          <textarea class="form-control" name="suggestions_inclusion" rows="3"></textarea>
        </div>

        <div class="buttons">
          <button type="button" class="btn-previous" id="prev8"><i class="fas fa-arrow-left"></i> Précédent</button>
          <button type="button" class="btn-next" id="next9">Suivant <i class="fas fa-arrow-right"></i></button>
        </div>
      </div>
      <!-- FIN SECTION 9 -->

      <!-- SECTION 10: LES RESSOURCES HUMAINES -->
      <div class="section" id="section10">
        <h2><i class="fas fa-handshake icon-label"></i>Les ressources humaines</h2>

        <div class="question">
          <label class="form-label">
            Que pensez-vous des relations entre agents publics et usagers ?
          </label>
          <textarea class="form-control" name="relations_agents_usagers" rows="3"></textarea>
        </div>

        <div class="question">
          <label class="form-label">
            Pourquoi ?
          </label>
          <textarea class="form-control" name="pourquoi_relations" rows="3"></textarea>
        </div>

        <!-- Boutons finaux -->
        <div class="buttons">
          <button type="button" class="btn-previous" id="prev10"><i class="fas fa-arrow-left"></i> Précédent</button>
          <button type="submit" class="btn-submit">Envoyer <i class="fas fa-paper-plane"></i></button>
        </div>
      </div>
      <!-- FIN SECTION 10 -->

    </div> <!-- FIN formContainer -->
  </form>

  <!-- JS (Bootstrap + Scripts) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // On récupère toutes les sections
    const sections = document.querySelectorAll(".section");
    let currentSectionIndex = 0;
    const totalSections = sections.length;

    // Sélection de la barre de progression et du label
    const progressFill = document.getElementById("progressFill");
    const progressLabel = document.getElementById("progressLabel");

    // IDs des boutons "Suivant" (correspondants à chaque section, sauf la dernière)
    const nextBtnIds = [
      "next1","next2","next3","next4","next5",
      "next6","next7","next8","next9","next10"
    ];

    // IDs des boutons "Précédent" (correspondants à chaque section, sauf la première)
    const prevBtnIds = [
      "prev1","prev2","prev3","prev4","prev5",
      "prev6","prev7","prev8","prev9","prev10"
    ];

    // Gestion du clic sur "Suivant"
    nextBtnIds.forEach((btnId) => {
      const btn = document.getElementById(btnId);
      if (btn) {
        btn.addEventListener("click", () => {
          currentSectionIndex = Math.min(currentSectionIndex + 1, totalSections - 1);
          updateSections();
          // Fait remonter la page en haut du formulaire
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    });

    // Gestion du clic sur "Précédent"
    prevBtnIds.forEach((btnId) => {
      const btn = document.getElementById(btnId);
      if (btn) {
        btn.addEventListener("click", () => {
          currentSectionIndex = Math.max(currentSectionIndex - 1, 0);
          updateSections();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    });

    function updateSections() {
      // Masquer toutes les sections
      sections.forEach((section, i) => {
        section.classList.remove("active", "animate__fadeIn");
        if (i === currentSectionIndex) {
          section.classList.add("active", "animate__fadeIn");
        }
      });

      // Calcul du pourcentage de progression
      const progressPercent = ((currentSectionIndex + 1) / totalSections) * 100;
      progressFill.style.width = progressPercent + "%";
      progressFill.setAttribute("aria-valuenow", progressPercent);

      // Mettre à jour le label "Étape X sur XX"
      progressLabel.textContent = `Étape ${currentSectionIndex + 1} sur ${totalSections}`;
    }

    // Affichage initial de la première section + mise à jour de la barre
    updateSections();

    // Intercepter la soumission du formulaire
    const form = document.getElementById("mainForm");
    form.addEventListener("submit", function(event) {
      // Si vous souhaitez un envoi AJAX, laissez l'event.preventDefault()
      // Sinon, retirez cette ligne pour un envoi classique.
      event.preventDefault();

      alert("Formulaire soumis avec succès. Merci de votre participation !");
      // Pour réellement soumettre le formulaire, retirez la ligne event.preventDefault().
    });
  </script>

</body>
</html>

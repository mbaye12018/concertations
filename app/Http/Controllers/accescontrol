<?php
namespace App\Http\Controllers;

use App\Models\AccesServicesPublics;
use App\Models\Soumission;
use Illuminate\Http\Request;

class AccesPublicsController extends Controller
{
    public function index()
    {
        // Récupérer les données avec liaison correcte
        $services = AccesServicesPublics::join('soumissions', 'acces_services_publics.id_soumission', '=', 'soumissions.id_soumission')
            ->select(
                'acces_services_publics.id_soumission',
                'services_frequentes',
                'accessibilite',
                'tranche_age',
                'sexe',
                'pays_diaspora'
            )
            ->get();

        // Initialisation des compteurs
        $servicesCount = [];
        $accessibilityCount = [
            'très accessible' => 0,
            'accessible' => 0,
            'moyennement accessible' => 0,
            'difficilement accessible' => 0,
            'très difficilement accessible' => 0
        ];
        $detailedServices = [];
        $ageGroups = [];
        $genderCount = ['Masculin' => 0, 'Féminin' => 0];
        $localityCount = ['Sénégal' => 0, 'Diaspora' => 0];

        // Compteur total pour le calcul des pourcentages
        $totalAccessibilities = 0;

        foreach ($services as $service) {
            $servicesArray = json_decode($service->services_frequentes, true) ?? [];
            $accessibilityRaw = json_decode($service->accessibilite, true) ?? [];

            // Vérification du format des données d’accessibilité
            if (is_array($accessibilityRaw)) {
                $accessibilityArray = $accessibilityRaw; // Format JSON tableau
            } elseif (is_object($accessibilityRaw)) {
                $accessibilityArray = array_values((array) $accessibilityRaw); // Format JSON objet
            } else {
                $accessibilityArray = []; // Valeur par défaut si erreur
            }

            foreach ($servicesArray as $index => $serv) {
                if (!isset($servicesCount[$serv])) {
                    $servicesCount[$serv] = 0;
                }
                $servicesCount[$serv]++;

                foreach ($accessibilityArray as $accessLevel) {
                    if (isset($accessibilityCount[$accessLevel])) {
                        $accessibilityCount[$accessLevel]++;
                        $totalAccessibilities++;
                    }

                    if (!isset($detailedServices[$serv])) {
                        $detailedServices[$serv] = [
                            'count' => 0,
                            'accessibility' => [
                                'très accessible' => 0,
                                'accessible' => 0,
                                'moyennement accessible' => 0,
                                'difficilement accessible' => 0,
                                'très difficilement accessible' => 0
                            ],
                            'gender' => ['Masculin' => 0, 'Féminin' => 0],
                            'locality' => ['Sénégal' => 0, 'Diaspora' => 0],
                            'age_groups' => []
                        ];
                    }

                    $detailedServices[$serv]['count']++;
                    if (isset($detailedServices[$serv]['accessibility'][$accessLevel])) {
                        $detailedServices[$serv]['accessibility'][$accessLevel]++;
                    }
                }
            }

            // Répartition par tranche d’âge
            $age = trim($service->tranche_age);
            if ($age) {
                if (!isset($ageGroups[$age])) {
                    $ageGroups[$age] = 0;
                }
                $ageGroups[$age]++;
            }

            // Répartition par sexe
            $gender = ucfirst(strtolower(trim($service->sexe)));
            if ($gender === "Masculin" || $gender === "Féminin") {
                $genderCount[$gender]++;
            }

            // Répartition par localité
            if (!empty($service->pays_diaspora)) {
                $localityCount['Diaspora']++;
            } else {
                $localityCount['Sénégal']++;
            }
        }

        // Calcul des pourcentages pour l’accessibilité
        if ($totalAccessibilities > 0) {
            foreach ($accessibilityCount as $key => $value) {
                $accessibilityCount[$key] = round(($value / $totalAccessibilities) * 100, 2);
            }
        }

        // Transformer les données pour Chart.js
        $servicesLabels = array_keys($servicesCount);
        $servicesData = array_values($servicesCount);
        $accessibilityLabels = array_keys($accessibilityCount);
        $accessibilityData = array_values($accessibilityCount);
        $ageLabels = array_keys($ageGroups);
        $ageData = array_values($ageGroups);
        $genderLabels = array_keys($genderCount);
        $genderData = array_values($genderCount);
        $localityLabels = array_keys($localityCount);
        $localityData = array_values($localityCount);

        return view('frontend.admin.acces_publics', compact(
            'servicesLabels', 'servicesData',
            'accessibilityLabels', 'accessibilityData',
            'detailedServices', 'ageLabels', 'ageData',
            'genderLabels', 'genderData',
            'localityLabels', 'localityData'
        ));
    }
}

